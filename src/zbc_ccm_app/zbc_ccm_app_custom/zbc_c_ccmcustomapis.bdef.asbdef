projection implementation in class ZBP_BC_CCM_CUSTOMC unique;
strict ( 2 );
extensible;
use draft;
use side effects;
define behavior for ZBC_C_CCMCustomAPIs alias CustomAPI
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action LoadContent;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

}