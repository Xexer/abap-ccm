@Metadata.layer: #CORE
@UI.headerInfo.title.type: #STANDARD
@UI.headerInfo.title.value: 'ObjectName'
@UI.headerInfo.description.type: #STANDARD
@UI.headerInfo.description.value: 'ProviderID'
annotate view ZBC_C_CCMCustomAPIs with
{
  @UI.facet: [
    {
      id: 'idGeneral',
      label: 'General Information',
      position: 10 ,
      type: #IDENTIFICATION_REFERENCE,
      targetQualifier: 'GENERAL'
    },
    {
      id: 'idDescription',
      label: 'Description',
      position: 20,
      type: #IDENTIFICATION_REFERENCE,
      targetQualifier: 'DESC'
    },
    {
      id: 'idAdmin',
      label: 'Admin Data',
      position: 30,
      type: #IDENTIFICATION_REFERENCE,
      targetQualifier: 'ADMIN'
    }
  ]

  @UI.selectionField: [ { position: 10  } ]
  @UI.lineItem: [ 
    { position: 10  },
    { type: #FOR_ACTION, label: 'Load Content', dataAction: 'LoadContent' } 
  ]
  @UI.identification: [ { position: 10 , qualifier: 'GENERAL' } ]
  ProviderID;

  @UI.selectionField: [ { position: 20  } ]
  @UI.lineItem: [ { position: 20  } ]
  @UI.identification: [ { position: 20 , qualifier: 'GENERAL' } ]
  ObjectType;

  @UI.selectionField: [ { position: 30  } ]
  @UI.lineItem: [ { position: 30  } ]
  @UI.identification: [ { position: 30 , qualifier: 'GENERAL' } ]
  ObjectName;

  @UI.lineItem: [ { position: 40  } ]
  @UI.identification: [ { position: 40 , qualifier: 'DESC' } ]
  @UI.multiLineText: true
  ShortDescription;

  @UI.identification: [ { position: 50 , qualifier: 'ADMIN' } ]
  LocalCreatedBy;

  @UI.identification: [ { position: 60 , qualifier: 'ADMIN' } ]
  LocalCreatedAt;

  @UI.identification: [ { position: 70 , qualifier: 'ADMIN' } ]
  LocalLastChangedBy;

  @UI.identification: [ { position: 80 , qualifier: 'ADMIN' } ]
  LocalLastChangedAt;

  @UI.identification: [ { position: 90 , qualifier: 'ADMIN' } ]
  LastChangedAt;

}