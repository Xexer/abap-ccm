managed implementation in class ZBP_BC_CCM_CUSTOM unique;
strict ( 1 );
with draft;
extensible;
auxiliary class zcl_bc_ccm_file_api_handler;

define behavior for ZBC_R_CCMCustomAPIs alias CustomAPI
persistent table zbc_ccm_custom
extensible
draft table zbc_ccm_customd
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  field ( mandatory : create )
  ProviderID,
  ObjectType,
  ObjectName;

  field ( readonly )
  LocalCreatedBy,
  LocalCreatedAt,
  LocalLastChangedBy,
  LocalLastChangedAt,
  LastChangedAt;

  field ( readonly : update )
  ProviderID,
  ObjectType,
  ObjectName;

  create;
  update;
  delete;

  static action LoadContentViaExcel deep parameter ZBC_S_CCMLoadExcel;
  static action LoadContentViaJSON parameter ZBC_S_CCMLoadJSON;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zbc_ccm_custom corresponding extensible
    {
      ProviderID         = PROVIDER_ID;
      ObjectType         = OBJ_TYPE;
      ObjectName         = OBJ_NAME;
      ShortDescription   = SHORT_DESCRIPTION;
      LocalCreatedBy     = LOCAL_CREATED_BY;
      LocalCreatedAt     = LOCAL_CREATED_AT;
      LocalLastChangedBy = LOCAL_LAST_CHANGED_BY;
      LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
      LastChangedAt      = LAST_CHANGED_AT;
    }
}